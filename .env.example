# Telegram sendMessage URL. The message is appended as a `text` query param.
# https://api.telegram.org/bot<BOT_TOKEN>/sendMessage?chat_id=<CHAT_ID>
ALERT_URL=https://api.telegram.org/bot123456:ABC-DEF/sendMessage?chat_id=987654321

# Ticker to watch
SYMBOL=TQQQ

# SMA period in trading days
SMA_PERIOD=200

# When to send the alert: always | above | below
ALERT_ON=always

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Human-readable coloured logs for local runs. Leave unset in the cloud so
# logs stay as one JSON object per line.
# LOG_PRETTY=true
