# Telegram sendMessage URL. The message is appended as a `text` query param.
# https://api.telegram.org/bot<BOT_TOKEN>/sendMessage?chat_id=<CHAT_ID>
ALERT_URL=https://api.telegram.org/bot123456:ABC-DEF/sendMessage?chat_id=987654321

# Ticker to watch
SYMBOL=TQQQ

# SMA period in trading days
SMA_PERIOD=200

# Send a message regardless of any cross. Only for checking your bot works.
# FORCE_ALERT=true
